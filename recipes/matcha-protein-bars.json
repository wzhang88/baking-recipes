  "steps": [
    {
      "zh": "把蛋液和开心果酱搅匀，加入混合好的干料，牛奶分次加。拌入开心果碎，铺平。",
      "en": "Mix the beaten egg with the pistachio paste. Add the combined dry ingredients, adding the milk gradually. Fold in the chopped pistachios and spread the mixture evenly."
    },
    {
      "zh": "预热至 320°F（160°C），烤 15–20 分钟。中心刚凝固时取出，放凉切成 6 根。",
      "en": "Preheat to 320°F (160°C) and bake for 15–20 minutes. Remove when the center has just set; cool and cut into 6 bars."
    }
  ],
  "notes": [
    {
      "zh": "想增加颗粒感时，可用 40 g 燕麦粉加 10 g 燕麦片。",
      "en": "For a more textured result, use 40 g oat flour plus 10 g rolled oats."
    }
