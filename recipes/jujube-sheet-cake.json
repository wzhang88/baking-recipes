  "steps": [
    {
      "zh": "红枣、水、黑糖和少许朗姆酒打成泥，炒干。",
      "en": "Blend the red dates, water, brown sugar, and a little rum into a paste, then cook it until dry."
    },
    {
      "zh": "蛋白加入 10 g 糖和少许塔塔粉，打发至偏硬。",
      "en": "Add 10 g sugar and a little cream of tartar to the egg whites; whip to fairly stiff peaks."
    },
    {
      "zh": "蛋黄与枣泥、玉米油搅匀，再与打发的蛋白拌匀，逐渐加入低筋面粉和泡打粉。",
      "en": "Mix the egg yolks with the jujube paste and corn oil, then fold in the whipped egg whites. Gradually add the cake flour and baking powder."
    },
    {
      "zh": "倒入 28×28 cm 方盘，300°F 烤 50 分钟。",
      "en": "Pour into a 28 × 28 cm square pan and bake at 300°F for 50 minutes."
    }
  ],
  "notes": [
