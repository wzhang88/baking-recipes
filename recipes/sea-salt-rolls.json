  "steps": [
    {
      "zh": "揉成均匀有弹性的面团，发酵后分成 8 份，松弛。",
      "en": "Knead into a smooth, elastic dough. Let it rise, divide into 8 pieces, and let them rest."
    },
    {
      "zh": "擀成长三角，从宽端包入每份 4–5 g 冰凉的黄油，卷成牛角。放在有边烤盘上做最后发酵。",
      "en": "Roll each piece into a long triangle. Place 4–5 g chilled butter at the wide end and roll into a crescent. Arrange on a rimmed baking sheet for the final proof."
    },
    {
      "zh": "撒少许海盐，预热至 425°F，烤 13–17 分钟，观察表面上色。",
      "en": "Sprinkle with a little sea salt. Preheat to 425°F and bake for 13–17 minutes, watching for surface browning."
    }
